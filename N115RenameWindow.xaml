<Window x:Class="NameTool.N115RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="12"
        Background="#F4F8FC">

    <Window.Resources>
        <!-- 与主窗口其它对话框一致的按钮观感（自己带模板，免得 hover 变色） -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C9DDF4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F2F8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E8F2FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主操作：与表格底部那条主按钮同色，一眼看出是确认动作 -->
        <Style x:Key="RenamePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1890FF"/>
            <Setter Property="BorderBrush" Value="#0F7AE5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4F6E95"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <!-- 上下布局：原文件名在上（只读 TextBox，可选中 / Ctrl+C / 右键复制），
         新文件名在下（可编辑、预填当前名字）。
         两个字段都用「标签一行 + 控件一行」，标签不跟输入框抢同一行宽度 ——
         窗口窄一点、名字长一点也不会把标签挤压缩。 -->
    <StackPanel Margin="16">
        <TextBlock Text="重命名文件" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,14"/>

        <TextBlock Text="原文件名（可选中复制）" Style="{StaticResource FieldLabelStyle}"/>
        <Border Background="#EDF3FA" BorderBrush="#D6E4F3" BorderThickness="1" CornerRadius="4" Padding="2,2">
            <!-- 只读 TextBox 而不是 TextBlock：文本能被鼠标拖选、Ctrl+A 全选、Ctrl+C 复制，
                 右键自带「复制」菜单。IsTabStop=False 保持 Tab 直达新文件名输入框。 -->
            <TextBox x:Name="OriginalNameBox" IsReadOnly="True" IsTabStop="False"
                     TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                     Foreground="#5A6B7D" Padding="6,4" Cursor="IBeam" SelectionBrush="#A8CDF0"/>
        </Border>

        <TextBlock Text="新文件名" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,5"/>
        <TextBox x:Name="NewNameBox" Height="30" Padding="8,0" VerticalContentAlignment="Center"
                 BorderBrush="#AECBEC" BorderThickness="1"
                 TextChanged="NewNameBox_TextChanged"
                 KeyDown="NewNameBox_KeyDown"/>

        <TextBlock x:Name="HintText" Margin="0,6,0,0" Foreground="#8A94A6" TextWrapping="Wrap"
                   Text="改完点「重命名」即可生效；按 Enter 也能确认。留空或与原文件名相同都不会提交。"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="RenameButton" Content="重命名" Click="Rename_Click"
                    Style="{StaticResource RenamePrimaryButtonStyle}"/>
        </StackPanel>
    </StackPanel>
</Window>
