<Window x:Class="NameTool.AboutHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 / 帮助"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="12"
        Background="#F4F8FC">

    <Window.Resources>
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C9DDF4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F2F8FF"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#87B6EA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E8F2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18">

        <!-- 头部：GitHub 图标 + 程序名与版本 -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Image Source="/Images/logo.png" Width="34" Height="34" Stretch="Uniform"/>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="NameTool" FontSize="17" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock x:Name="VersionText" FontSize="11" Foreground="#8A94A6" Margin="0,1,0,0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="批量文件改名工具（字幕 / 媒体 / 任意格式），支持 115 网盘。免费使用，觉得好用欢迎去 GitHub 点个 Star。"
                   TextWrapping="Wrap" Foreground="#5A6B7D" Margin="0,2,0,14"/>

        <!-- 三个入口 -->
        <Button Style="{StaticResource LinkButtonStyle}" Margin="0,0,0,8" Click="OpenGitHub_Click"
                ToolTip="https://github.com/vic4728/NameTool">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="/Images/ico/github-fill.png" Width="18" Height="18" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="GitHub 地址" FontWeight="SemiBold" Foreground="#2C3E50"/>
                    <TextBlock Text="github.com/vic4728/NameTool" FontSize="11" Foreground="#8A94A6"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="打开 ↗" VerticalAlignment="Center" Foreground="#1890FF" FontWeight="SemiBold"/>
            </Grid>
        </Button>

        <Button Style="{StaticResource LinkButtonStyle}" Margin="0,0,0,8" Click="OpenIssues_Click"
                ToolTip="https://github.com/vic4728/NameTool/issues">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="💬" FontSize="16" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="反馈问题" FontWeight="SemiBold" Foreground="#2C3E50"/>
                    <TextBlock Text="github.com/vic4728/NameTool/issues" FontSize="11" Foreground="#8A94A6"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="打开 ↗" VerticalAlignment="Center" Foreground="#1890FF" FontWeight="SemiBold"/>
            </Grid>
        </Button>

        <Button Style="{StaticResource LinkButtonStyle}" Click="OpenDownload_Click"
                ToolTip="https://svr.jcsit.cn/NameTool/update/">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⬇" FontSize="16" VerticalAlignment="Center" Foreground="#1890FF"/>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="下载新版本" FontWeight="SemiBold" Foreground="#2C3E50"/>
                    <TextBlock Text="svr.jcsit.cn/NameTool/update/" FontSize="11" Foreground="#8A94A6"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="打开 ↗" VerticalAlignment="Center" Foreground="#1890FF" FontWeight="SemiBold"/>
            </Grid>
        </Button>

        <!-- 最新版本信息（打开弹窗时后台查询服务器；查询中显示占位） -->
        <Border Background="#F7FAFE" BorderBrush="#DCE9F7" BorderThickness="1" CornerRadius="4"
                Padding="10,8" Margin="0,10,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="最新发布版本：" Foreground="#5A6B7D"/>
                        <TextBlock x:Name="LatestVersionText" Text="查询中…" FontWeight="SemiBold" Foreground="#8A94A6"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="更新内容" Height="24" Padding="8,2"
                            Style="{StaticResource LinkButtonStyle}"
                            FontWeight="SemiBold" Foreground="#1890FF"
                            Click="ToggleNotes_Click" Visibility="Collapsed"
                            x:Name="ToggleNotesButton"/>
                </Grid>
                <TextBlock x:Name="LatestHintText" FontSize="11" Foreground="#8A94A6" Margin="0,3,0,0"
                           Text="正在从更新服务器获取…"/>
            </StackPanel>
        </Border>

        <!-- 右下角作者落款：内凹（sunken）样式 —— 深色文字 + 亮色底边/暗色顶边模拟下陷，
             用 Border 做内凹浮雕（OuterBorderColor 比背景暗、内圈亮），文字灰色。 -->
        <Grid Margin="0,16,0,0">
            <TextBlock x:Name="CopyrightText" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="#B0BCCB" FontSize="11"/>
            <Border HorizontalAlignment="Right" Padding="8,3"
                    BorderBrush="#FFFFFF" BorderThickness="0,1,0,0" CornerRadius="2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#E9EDF2" Offset="0"/>
                        <GradientStop Color="#F7FAFD" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="作者：Vic4728" FontSize="11" Foreground="#8A94A6"
                           Margin="0,1,0,0"/>
            </Border>
        </Grid>
    </StackPanel>
</Window>
