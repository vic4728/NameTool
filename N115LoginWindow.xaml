<Window x:Class="NameTool.N115LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="115 网盘登录授权"
        Width="600" Height="700"
        MinWidth="560" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="12"
        Background="#D9DDDF">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#797979"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                CornerRadius="4.5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 分区：标签头（灰底圆角顶） + 白色内容卡（圆角底），还原设计稿的分段卡结构 -->
        <Style x:Key="SectionTabStyle" TargetType="Border">
            <Setter Property="Background" Value="#E6E7E7"/>
            <Setter Property="BorderBrush" Value="#797979"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="CornerRadius" Value="8.5,8.5,0,0"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style x:Key="SectionBodyStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#797979"/>
            <Setter Property="BorderThickness" Value="1,0,1,1"/>
            <Setter Property="CornerRadius" Value="0,0,8.5,8.5"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
        <Style x:Key="SectionTabTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#858585"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- 扁平方块单选（设计稿样式：选中蓝底白字，未选灰底黑字，直角） -->
        <Style x:Key="ChipStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#080808"/>
            <Setter Property="Background" Value="#DFDBDB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#797979"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="#008CFF"/>
                                <Setter Property="Foreground" Value="#FDFCFC"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ChipBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 授权状态徽章（设计稿：浅绿底绿字 + 对勾，已授权时） -->
        <Style x:Key="BadgeBaseStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 内嵌浏览器：不可见，只用于「网页已登录」的 Cookie 自动检测（0 高度不抢布局） -->
        <wv2:WebView2 x:Name="Web" Grid.Row="0" Height="0" HorizontalAlignment="Left"
                      Width="0" Visibility="Hidden"/>

        <!-- 徽章状态开关（代码后置改 IsChecked 驱动两个状态徽章的 DataTrigger，不参与布局） -->
        <CheckBox x:Name="HasCookieBadge" Visibility="Collapsed" IsChecked="False"/>
        <CheckBox x:Name="HasOpenApiBadge" Visibility="Collapsed" IsChecked="False"/>

        <!-- ============ ① 授权设置 ============ -->
        <StackPanel Grid.Row="0">
            <Border Style="{StaticResource SectionTabStyle}">
                <TextBlock Style="{StaticResource SectionTabTextStyle}" Text="授权设置"/>
            </Border>
            <Border Style="{StaticResource SectionBodyStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 授权方式 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="授权方式"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="ModeWebQr" Style="{StaticResource ChipStyle}"
                                     GroupName="AuthMode" IsChecked="True" MinWidth="137" Height="24"
                                     Content="网页扫描授权(推荐)"
                                     Checked="ModeWebQr_Checked"/>
                        <RadioButton x:Name="ModeOpenApi" Style="{StaticResource ChipStyle}"
                                     GroupName="AuthMode" MinWidth="137" Height="24"
                                     Content="自定义 AppID扫码"
                                     Checked="ModeOpenApi_Checked"/>
                    </StackPanel>

                    <!-- 授权设备（下拉选择框） -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="授权设备"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox x:Name="DeviceBox" Width="186" Height="29"
                                  VerticalContentAlignment="Center"
                                  Background="#EBEBEB"
                                  ToolTip="选择扫码授权所占用的设备登录位（同类设备互踢：所选通道再次授权会替换它上面已有的登录）"
                                  SelectionChanged="Device_SelectionChanged"/>
                    </StackPanel>

                    <!-- AppID（仅 OpenAPI 方式可见） -->
                    <TextBlock x:Name="AppIdLabel" Grid.Row="2" Grid.Column="0" Style="{StaticResource FormLabelStyle}"
                               Text="AppID" Visibility="Collapsed"/>
                    <StackPanel x:Name="AppIdPanel" Grid.Row="2" Grid.Column="1"
                                Orientation="Horizontal" Visibility="Collapsed">
                        <TextBox x:Name="AppIdBox" Width="240" Height="26" Padding="6,2"
                                 VerticalContentAlignment="Center"
                                 FontFamily="Consolas, Microsoft YaHei"
                                 ToolTip="在 115 生活开放平台（open.115.com）申请的应用 AppID"/>
                        <TextBlock Margin="8,0,0,0" Style="{StaticResource HintStyle}" VerticalAlignment="Center"
                                   Text="在 open.115.com 申请"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ============ ② 扫描授权 ============ -->
        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <Border Style="{StaticResource SectionTabStyle}">
                <TextBlock Style="{StaticResource SectionTabTextStyle}" Text="扫描授权"/>
            </Border>
            <Border Style="{StaticResource SectionBodyStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左：二维码（设计稿 163px，取 170px） -->
                        <Border Grid.Column="0" Width="170" Height="170" Margin="0,2,0,2"
                                VerticalAlignment="Top"
                                Background="#FFFFFF"
                                BorderBrush="#797979"
                                BorderThickness="1">
                            <Grid>
                                <Image x:Name="QrImage" Margin="6" Stretch="Uniform"/>
                                <TextBlock x:Name="QrPlaceholder" Text="二维码将显示在这里"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#B9C6D6" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 右：竖排三个按钮（设计稿布局：按钮在二维码右侧） -->
                        <StackPanel Grid.Column="1" Margin="16,4,0,0" VerticalAlignment="Top">
                            <Button x:Name="StartButton" Content="开始授权" Width="111" Height="30" Margin="0,4,0,16"
                                    HorizontalAlignment="Left"
                                    Background="#3087E7" Foreground="White" BorderBrush="#797979" FontWeight="Bold"
                                    Click="Start_Click"/>
                            <Button x:Name="RefreshQrButton" Content="刷新二维码" Width="111" Height="30" Margin="0,0,0,16"
                                    HorizontalAlignment="Left"
                                    Background="#DBF3BA" Foreground="#2C2B2B" BorderBrush="#797979"
                                    IsEnabled="False" Click="RefreshQr_Click"/>
                            <Button Content="打开115网页" Width="111" Height="30"
                                    HorizontalAlignment="Left"
                                    Background="#FFFFFF" Foreground="#2C2B2B" BorderBrush="#797979"
                                    Click="OpenWeb_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 状态文字横贯卡片底部（设计稿底部那行加粗说明） -->
                    <TextBlock x:Name="QrStatusText"
                               TextAlignment="Left"
                               TextWrapping="Wrap"
                               MinHeight="22"
                               FontWeight="Bold"
                               Foreground="#333333"
                               Margin="0,10,0,0"
                               Text="点「开始授权」生成二维码，用手机 115 App 扫码并在手机上确认"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ============ ③ 115接口设置 ============ -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <Border Style="{StaticResource SectionTabStyle}">
                <TextBlock Style="{StaticResource SectionTabTextStyle}" Text="115接口设置"/>
            </Border>
            <Border Style="{StaticResource SectionBodyStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 接口优先 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="接口优先"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <RadioButton x:Name="ApiPreferCookie" Style="{StaticResource ChipStyle}"
                                     GroupName="ApiPreference" IsChecked="True" MinWidth="106" Height="24"
                                     Content="优先 Cookie"
                                     Checked="ApiPreference_Checked"/>
                        <RadioButton x:Name="ApiPreferOpen" Style="{StaticResource ChipStyle}"
                                     GroupName="ApiPreference" MinWidth="106" Height="24"
                                     Content="优先 OpenAPI"
                                     Checked="ApiPreference_Checked"/>
                    </StackPanel>

                    <!-- 说明行 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               Style="{StaticResource HintStyle}" Margin="0,6,0,0"
                               Text="Cookie: 模拟某台设备上的客户端　OpenAPI: 官方开放平台 OAuth2.0"/>

                    <!-- Cookie 行（设计稿：Cookie + 绿色状态徽章 + 右侧橙色重新授权） -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FormLabelStyle}" Margin="0,10,0,0"
                               Text="Cookie"/>
                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" HorizontalAlignment="Left" CornerRadius="3" Padding="8,2"
                                VerticalAlignment="Center" Background="#F3F4F4" BorderBrush="#C9C9C9" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=HasCookieBadge}" Value="True">
                                            <Setter Property="Background" Value="#C9F7B1"/>
                                            <Setter Property="BorderBrush" Value="#8FCD6F"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock x:Name="ApiCookieStatus" Style="{StaticResource HintStyle}" Foreground="#858585"
                                       Text="未授权"/>
                        </Border>
                        <Button x:Name="RecookieButton" Grid.Column="1" Content="重新获取" Width="83" Height="25"
                                Background="#FF6618" Foreground="White" BorderBrush="#797979"
                                ToolTip="按上方选择的授权设备重新扫码获取 Cookie"
                                Click="Recookie_Click"/>
                    </Grid>

                    <!-- OpenAPI 行（设计稿：OpenAPI + 绿色状态徽章 + 右侧蓝色重新登录） -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FormLabelStyle}" Margin="0,10,0,0"
                               Text="OpenAPI"/>
                    <Grid Grid.Row="3" Grid.Column="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" HorizontalAlignment="Left" CornerRadius="3" Padding="8,2"
                                VerticalAlignment="Center" Background="#F3F4F4" BorderBrush="#C9C9C9" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=HasOpenApiBadge}" Value="True">
                                            <Setter Property="Background" Value="#C9F7B1"/>
                                            <Setter Property="BorderBrush" Value="#8FCD6F"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock x:Name="ApiOpenStatus" Style="{StaticResource HintStyle}" Foreground="#858585"
                                       Text="未授权"/>
                        </Border>
                        <Button x:Name="ReopenApiButton" Grid.Column="1" Content="重新登录" Width="83" Height="25"
                                Background="#188EFF" Foreground="White" BorderBrush="#797979"
                                ToolTip="用上方填写的 AppID 重新走 OpenAPI 设备码扫码授权"
                                Click="ReopenApi_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ============ 底部按钮 ============ -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="取消" Width="88" Height="30" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
