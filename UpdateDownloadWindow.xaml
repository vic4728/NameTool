<Window x:Class="NameTool.UpdateDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="下载更新"
        Width="400" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F4F8FC"
        Closing="Window_Closing">
    <!-- 与主窗口风格对齐（原先是灰底 #E9E9E9 + 灰槽 + 黄绿渐变，跟主界面完全不搭）：
         浅蓝底 #F4F8FC、进度槽白底浅蓝边、进度填充蓝色 #1890FF、按钮沿用橙色强调。 -->
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="FileNameText"
                   Text="正在下载..."
                   FontSize="18"
                   Foreground="#33475B"/>

        <Grid x:Name="ProgressTrack" Grid.Row="2" Height="24">
            <Border CornerRadius="12" Background="#FFFFFF" BorderBrush="#C9DDF4" BorderThickness="1"/>
            <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" CornerRadius="12"
                    Background="#1890FF"/>
            <TextBlock x:Name="PercentText"
                       Text="0%"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#33475B"
                       FontSize="14"/>
        </Grid>

        <Button x:Name="CancelButton"
                Grid.Row="4"
                Content="取消升级"
                Width="120" Height="32"
                HorizontalAlignment="Center"
                Background="#F5821F"
                Foreground="White"
                FontWeight="SemiBold"
                FontSize="14"
                BorderBrush="#D96F10"
                Click="Cancel_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Border x:Name="CancelOverlay" CornerRadius="4" Background="Transparent"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CancelOverlay" Property="Background" Value="#26000000"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CancelOverlay" Property="Background" Value="#40000000"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
