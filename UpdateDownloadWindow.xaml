<Window x:Class="NameTool.UpdateDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="下载更新"
        Width="400" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#E9E9E9"
        Closing="Window_Closing">
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="FileNameText"
                   Text="正在下载..."
                   FontSize="18"/>

        <Grid x:Name="ProgressTrack" Grid.Row="2" Height="24">
            <Border CornerRadius="12" Background="#A7A7A7"/>
            <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" CornerRadius="12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#C8E86A" Offset="0"/>
                        <GradientStop Color="#9CCC1A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <TextBlock x:Name="PercentText"
                       Text="0%"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#5D6A3A"
                       FontSize="14"/>
        </Grid>

        <Button x:Name="CancelButton"
                Grid.Row="4"
                Content="取消升级"
                Width="120" Height="32"
                HorizontalAlignment="Center"
                Foreground="White"
                FontSize="14"
                BorderBrush="#D47A13"
                Click="Cancel_Click">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFA238" Offset="0"/>
                    <GradientStop Color="#F57D00" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
