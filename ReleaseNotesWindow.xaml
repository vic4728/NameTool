<Window x:Class="NameTool.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="更新内容"
        Width="500"
        SizeToContent="Height"
        MaxHeight="580"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="12"
        Background="#F4F8FC">

    <StackPanel Margin="18">
        <!-- 头部：渐变横幅（蓝→紫），版本徽章 + 说明 -->
        <Border CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1890FF" Offset="0"/>
                    <GradientStop Color="#722ED1" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Background="#33FFFFFF" CornerRadius="9" Padding="10,2" VerticalAlignment="Center">
                        <TextBlock x:Name="LatestVersionText" Text="…" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>
                    <TextBlock Text="最新发布" FontSize="13" Foreground="#E6F4FF" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="HintText" FontSize="11" Foreground="#D6E9FF" Margin="0,4,0,0"
                           TextWrapping="Wrap" Text="正在从更新服务器获取…"/>
            </StackPanel>
        </Border>

        <!-- 更新内容列表：按「新功能 / 修复 / 其它」三段分组，各组彩色圆角卡片 -->
        <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="NotesHost">
                <TextBlock x:Name="EmptyText" Foreground="#8A94A6" Margin="4,8"
                           Text="正在从更新服务器获取…"/>
            </StackPanel>
        </ScrollViewer>

        <Button Content="关闭" Width="88" Height="28" Margin="0,14,0,0" HorizontalAlignment="Right"
                Background="#FFFFFF" BorderBrush="#C9DDF4" Click="Close_Click"/>
    </StackPanel>
</Window>
