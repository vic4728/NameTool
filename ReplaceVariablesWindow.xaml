<Window x:Class="NameTool.ReplaceVariablesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="说明（批量替换）"
        Width="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="12"
        Background="#F4F8FC">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C9DDF4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F2F8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E8F2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="通配符（旧写法，继续支持）" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,4"/>
        <TextBlock Text="写进「查找」里当通配符用；「替换」里的 ### 按出现顺序引用查找时记住的内容。同样可以选中复制。"
                   TextWrapping="Wrap" Foreground="#5A6B7D" Margin="0,0,0,12"/>

        <StackPanel x:Name="WildcardRowsHost"/>

        <TextBlock Text="示例：  查找 第###集  替换留空  →  「第005集」这类文本会被删除"
                   Foreground="#4F6E95" Margin="0,12,0,0" TextWrapping="Wrap"/>

        <TextBlock Text="查找替换 · 变量" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,18,0,4"/>
        <TextBlock Text="写进「查找」里当通配符用（匹配到什么就记下来），写进「替换」里则引用查找时记住的内容。同样可以选中复制。"
                   TextWrapping="Wrap" Foreground="#5A6B7D" Margin="0,0,0,12"/>

        <StackPanel x:Name="RuleRowsHost"/>

        <TextBlock Text="示例1：  查找 {英文}{数字}  替换 {英文}-{数字}  →  Abcd001 变成 Abcd-001"
                   Foreground="#4F6E95" Margin="0,12,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="示例2：  查找 {英文}{数字}{后缀名=mp4}  替换 {大写英文}-{数字}{后缀名=MKV}  →  Abcd001.mp4 变成 ABCD-001.MKV"
                   Foreground="#4F6E95" Margin="0,4,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="小提示：查找里写了 {后缀名=mp4} 时，替换里记得用 {后缀名=新扩展名} 把扩展名写回去，不然扩展名会跟着一起被替换掉。"
                   Foreground="#8A94A6" Margin="0,4,0,0" TextWrapping="Wrap"/>

        <Button Content="关闭" Width="76" Height="26" HorizontalAlignment="Right" Margin="0,14,0,0" Click="Close_Click"/>
    </StackPanel>
</Window>
