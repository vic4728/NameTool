<Window x:Class="NameTool.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F4F8FC"
        MaxHeight="520">
    <!-- 更新弹窗：标题栏「检查更新」发现新版本时弹出的专用对话框。
         与 MessageDialogWindow 同一视觉体系（浅蓝底 #F4F8FC、蓝 #1890FF 主按钮、白底浅蓝边框次按钮）。
         正文 = 新版号 + 当前版本 + 文件大小 + 大白话更新内容列表；按钮 = 「确定」（立即更新）/「忽略更新」。 -->
    <Window.Resources>
        <!-- 对话框按钮公共模板：圆角 4 + 半透明遮罩 hover/pressed（与 MessageDialogWindow 同款） -->
        <ControlTemplate x:Key="DialogButtonTemplate" TargetType="Button">
            <Border x:Name="DialogButtonBorder" CornerRadius="4"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Border x:Name="DialogButtonOverlay" CornerRadius="4" Background="Transparent"/>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="DialogButtonOverlay" Property="Background" Value="#14000000"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="DialogButtonOverlay" Property="Background" Value="#26000000"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="DialogButtonBorder" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1890FF"/>
            <Setter Property="BorderBrush" Value="#0F7AE5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template" Value="{StaticResource DialogButtonTemplate}"/>
        </Style>

        <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9DDF4"/>
            <Setter Property="Foreground" Value="#33475B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template" Value="{StaticResource DialogButtonTemplate}"/>
        </Style>
    </Window.Resources>

    <Border Background="#F4F8FC" Padding="18,16,18,14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部：图标 + 新版本号 + 当前版本 / 文件大小 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="18"
                        Background="#1890FF" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17"
                               Foreground="White" Text="&#xE896;"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText" FontSize="15" FontWeight="Bold" Foreground="#1F2D3D"
                               Text="发现新版本"/>
                    <TextBlock x:Name="SubHeaderText" FontSize="12" Foreground="#8A94A6" Margin="0,3,0,0"
                               Text="当前版本"/>
                </StackPanel>
            </StackPanel>

            <!-- 更新内容列表：长列表可滚动（MaxHeight 兜底，弹窗不超过 MaxHeight） -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="本次更新内容：" FontSize="13" FontWeight="SemiBold" Foreground="#33475B"/>
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <ItemsControl x:Name="NotesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                                    <TextBlock Text="·" FontSize="13" Foreground="#1890FF" FontWeight="Bold"
                                               Margin="6,0,7,0" VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding}" FontSize="13" Foreground="#33475B"
                                               TextWrapping="Wrap" MaxWidth="360"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- 按钮行：右对齐 ——「确定」立即更新（主）、「忽略更新」（次） -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="IgnoreButton" Content="忽略更新" Width="96" Height="30"
                        Style="{StaticResource DialogSecondaryButtonStyle}" Click="Ignore_Click"/>
                <Button x:Name="ConfirmButton" Content="确定" Width="84" Height="30"
                        Margin="8,0,0,0" IsDefault="True"
                        Style="{StaticResource DialogPrimaryButtonStyle}" Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
