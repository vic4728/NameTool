    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DCE6F2" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Width="16" Height="16" Margin="8,0,2,0" VerticalAlignment="Center" Source="/Images/logo-2-1.ico"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                    <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontSize="15" Foreground="#333" Text="NameTool"/>
                    <!-- 版本号胶囊：紧凑（高 17 / 字号 11 / 左右 6），主题蓝底白字 -->
                    <Border x:Name="VersionPill" Height="17" CornerRadius="8.5" Background="#1890FF"
                            VerticalAlignment="Center" Margin="6,0,0,0" Padding="6,0">
                        <TextBlock x:Name="VersionPillText" Text="v0.0.0" FontSize="11" FontWeight="Bold"
                                   Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="By Vic4728" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="#8A94A6"/>
                </StackPanel>

                <TextBlock x:Name="UpdateNoticeText"
                           Grid.Column="2"
                           Margin="8,0,10,0"
                           VerticalAlignment="Center"
                           Foreground="#D62828"
                           FontWeight="Bold"
                           FontSize="12"
                           Cursor="Hand"
                           TextDecorations="Underline"
                           Visibility="Collapsed"
                           MouseLeftButtonUp="UpdateNotice_Click"
                           Text="发现新版本，点击升级"/>

                <Button Grid.Column="3" Content="—" FontSize="12" Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeWindow_Click"/>
                <Button Grid.Column="4" Content="×" FontSize="20" Style="{StaticResource TitleBarButtonStyle}" Click="CloseWindow_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <!-- 列表区 : 功能区 = 2 : 1（原先 3 : 2）。
                     把更多宽度让给左侧列表（两个 DataGrid 的列宽都是 *，会跟着一起变宽）；
                     功能区只剩约 1/3，所以里面所有固定宽度都必须改成可伸缩 / 可换行，
                     并给出 MinWidth 下限 —— 到 420 就是功能区还能排得下的极限。
                     左侧留 500 下限，保证「参与 / 原文件名 / 预览 / 状态」四列不被压扁。 -->
                <ColumnDefinition Width="2*" MinWidth="500"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

        <GroupBox Margin="0,0,10,0" Background="#F6FBFF">
            <GroupBox.Style>
                <Style TargetType="GroupBox" BasedOn="{StaticResource RoundedGroupBoxStyle}">
                    <Setter Property="Header" Value="文件列表"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentMode}" Value="Editor">
                            <Setter Property="Header" Value="{Binding SelectedFile.OriginalFileName, StringFormat='编辑: {0}'}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding N115.IsActive}" Value="True">
                            <Setter Property="Header" Value="115 网盘"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </GroupBox.Style>
            <DockPanel>
                <Border x:Name="DropHintBorder"
                        DockPanel.Dock="Bottom"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Background="#E6F2FF"
                        BorderBrush="#1890FF"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,6"
                        Margin="0,8,0,0">
                    <TextBlock HorizontalAlignment="Center"
                               FontWeight="Bold"
                               Foreground="#1890FF"
                               Text="松开鼠标即可添加文件（任意格式，可直接拖入文件夹；文本类文件可编辑内容）"/>
                </Border>

                <!-- 本地文件工具栏：只在「本地 + 列表模式」显示。
                     以前这一条在编辑模式下也照旧显示，按钮 + 提示文字加起来比左栏还宽，
                     末尾的「返回列表」被挤到可视区之外，用户反馈「进了编辑模式找不到退出的地方」。
                     现在编辑模式换成下面那条专用的返回条。 -->
                <StackPanel x:Name="LocalToolbar" Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding N115.IsLocalMode}" Value="True"/>
                                        <Condition Binding="{Binding CurrentMode}" Value="List"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="添加文件..." Click="AddFiles_Click" Width="92" Height="30" Margin="0,0,6,0"/>
                    <Button Content="添加文件夹..." Click="AddFolder_Click" Width="98" Height="30" Margin="0,0,6,0"/>
                    <Button Content="移除" Click="RemoveFiles_Click" Width="72" Height="30" Margin="0,0,6,0"
                            Foreground="#D62828" BorderBrush="#D62828"
                            ToolTip="把列表中选中的文件移出列表（不删除文件本体）。&#10;可按住 Ctrl / Shift 多选；选中后按 Delete 键同样可移除。"/>
                    <Button Content="清空" Command="{Binding ClearFilesCommand}" Width="72" Height="30" Margin="0,0,6,0" Foreground="#FA8C16" BorderBrush="#FA8C16"/>
                    <Button Content="115网盘" Click="OpenN115_Click" Width="86" Height="30" Margin="0,0,6,0"
                            Background="#EAF4FF" BorderBrush="#87B6EA" FontWeight="Bold"/>
                    <!-- 繁=>简双路由：网盘模式转网盘选中项名称，本地模式转本地文件 -->
                    <Button Content="繁=&gt;简" Width="76" Height="30" Margin="0,0,6,0"
                            Background="#FFF3E8" BorderBrush="#EBC79A"
                            ToolTip="把文件名（网盘模式下为选中条目名）里的繁体字转成简体。&#10;· 本地模式：文本 / 字幕内容会改写正文（写回前留 .bak 备份），二进制文件只改文件名&#10;· 只处理勾选的文件 / 网盘选中的条目（一个都没选中则本地处理全部）&#10;· 文件名可点「撤销」回退">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Command" Value="{Binding RunToSimplifiedCommand}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding N115.IsActive}" Value="True">
                                        <Setter Property="Command" Value="{Binding N115.ToSimplifiedCommand}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <CheckBox Content="递归扫描文件夹" IsChecked="{Binding RecursiveAddFolder}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 字幕编辑工具条：只在「本地 + 编辑模式」显示。
                     返回按钮放在最左边，不受列宽影响；按 Esc 也能回列表。 -->
                <Border x:Name="EditorToolbar" DockPanel.Dock="Top" Margin="0,0,0,8"
                        Background="#FFF7EE" BorderBrush="#F3D3AC" BorderThickness="1"
                        CornerRadius="4" Padding="8,5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding N115.IsLocalMode}" Value="True"/>
                                        <Condition Binding="{Binding CurrentMode}" Value="Editor"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <!-- WrapPanel 而不是 StackPanel：左栏收窄时编码下拉自动换行，而不是把尾部元素硬裁掉 -->
                    <WrapPanel>
                        <Button Content="← 返回列表"
                                Command="{Binding ReturnToListCommand}"
                                Style="{StaticResource OrangeButtonStyle}"
                                Width="104" Height="28" Margin="0,0,12,0"
                                ToolTip="回到文件列表（也可以直接按 Esc）。改动过的内容保留在列表里，不会丢。"/>
                        <Button Content="保存"
                                Command="{Binding SaveSubtitleCommand}"
                                Width="72" Height="28" Margin="0,0,6,0"
                                Background="#1890FF" Foreground="White"
                                ToolTip="把编辑器里的内容原样写回这个文件（沿用当前编码，编码转换后即为转换后的编码），不套用右侧任何规则。"/>
                        <Button Content="另存为…"
                                Click="SaveSubtitleAs_Click"
                                Width="86" Height="28" Margin="0,0,12,0"
                                ToolTip="把编辑器里的内容另存为另一个文件，原文件不动。"/>
                        <TextBlock Text="编码：" VerticalAlignment="Center" Foreground="#8A5A1E"/>
                        <ComboBox ItemsSource="{Binding EncodingChoices}"
                                  SelectedItem="{Binding SelectedEncodingChoice}"
                                  Width="150" Height="26" Margin="0,0,12,0"
                                  VerticalContentAlignment="Center"
                                  ToolTip="把当前字幕转换成所选编码后保存（内容不变，只改编码）。
选 GB2312 时若有生僻字装不下会提示取消，可改用 GBK / GB18030。
之后点「保存」会自动沿用转换后的编码，状态栏会显示实际落盘的编码。"/>
                        <TextBlock Text="{Binding EditorStatusText}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="260"
                                   Foreground="#1D7A3F" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"/>
                        <CheckBox Content="自动保存" IsChecked="{Binding AutoSaveEnabled}"
                                  VerticalAlignment="Center" Margin="12,0,4,0"
                                  ToolTip="编辑期间定时把**未保存的改动**备份到与原文件同目录的「原文件名_bak.扩展名」。&#10;手动「保存」或选择不保存退出时会自动删除备份；&#10;程序崩溃 / 被强行结束进程时备份保留在磁盘上，可手动找回。"/>
                        <TextBlock Text="|" VerticalAlignment="Center" Foreground="#D9C49A"/>
                        <TextBox Width="42" Height="26" Margin="4,0,2,0"
                                 Text="{Binding AutoSaveSeconds}"
                                 VerticalContentAlignment="Center"
                                 ToolTip="自动备份间隔（秒），最小 1，默认 10"/>
                        <TextBlock Text="秒" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="#8A5A1E"/>
                    </WrapPanel>
                </Border>

                <!-- 115 网盘工具栏：第一行操作按钮 + 账号，第二行当前路径（独占一行，方便看清层级） -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8"
                      Visibility="{Binding N115.IsActive, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                        <Button Content="返回本地列表" Click="ExitN115_Click" Width="106" Height="30" Margin="0,0,6,0"
                                Style="{StaticResource OrangeButtonStyle}"/>
                        <Button Content="根目录" Command="{Binding N115.GoRootCommand}" Width="66" Height="30" Margin="0,0,6,0"/>
                        <Button Content="刷新" Command="{Binding N115.RefreshCommand}" Width="60" Height="30" Margin="0,0,6,0"/>
                        <Rectangle Width="1" Height="20" Fill="#D6E4F3" Margin="4,0,10,0" VerticalAlignment="Center"/>
                        <Button Content="移动到…" Command="{Binding N115.MoveToCommand}" Width="76" Height="30" Margin="0,0,6,0"
                                ToolTip="把选中项移动到你挑选的目录（选中的文件夹不能移进它自己）"/>
                        <Button Content="复制到…" Command="{Binding N115.CopyToCommand}" Width="76" Height="30" Margin="0,0,6,0"
                                ToolTip="把选中项复制到你挑选的目录，原位置内容不变"/>
                        <Button Content="重命名" Command="{Binding N115.RenameSingleCommand}" Width="76" Height="30" Margin="0,0,6,0"
                                ToolTip="给单个文件或文件夹改名字：弹窗里填新名字，确认后立即生效（不套用右侧任何规则）。&#10;只支持单个条目 —— 多选时不可用；&#10;批量改名请用表格底部的「按右侧规则重命名」"/>
                        <Button Content="删除" Command="{Binding N115.DeleteSelectedCommand}" Width="60" Height="30" Margin="0,0,6,0"
                                Foreground="#C0392B" BorderBrush="#E8A9A9"
                                ToolTip="删除选中项（进入 115 回收站，可在 115 网页版恢复）"/>
                        <Button Content="重新登录" Command="{Binding N115.ReloginCommand}" Width="76" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding N115.AccountText}" VerticalAlignment="Center" Foreground="#4F6E95" Margin="0,0,8,0" FontWeight="Bold"/>
                        <Button Content="退出登录" Command="{Binding N115.LogoutCommand}" Width="88" Height="30" Margin="4,0,0,0"/>
                    </StackPanel>

                    <!-- 当前路径：按钮行下方独占一行；行尾挂「新建文件夹」图标按钮（在当前目录创建） -->
                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            Background="#F6FBFF"
                            BorderBrush="#DCE9F7"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="路径：" VerticalAlignment="Center"
                                       Foreground="#8A94A6" FontWeight="Bold"/>

                            <ScrollViewer Grid.Column="1"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="N115Crumbs" ItemsSource="{Binding N115.Crumbs}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&gt;" VerticalAlignment="Center" Margin="4,0,4,0"
                                                           Foreground="#8A94A6" FontWeight="Bold"
                                                           Visibility="{Binding ShowSeparator, Converter={StaticResource BoolToVis}}"/>
                                                <!-- 只用文字（不带图标、不带边框），点击即跳到该层级 -->
                                                <Button Style="{StaticResource CrumbLinkStyle}"
                                                        Height="22"
                                                        Content="{Binding Name}"
                                                        Command="{Binding DataContext.N115.GoToCrumbCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- 新建文件夹：图标按钮（Images/ico/new file-ico.png），
                                 建在路径栏当前所在的目录里 -->
                            <Button Grid.Column="2" Click="N115NewFolder_Click"
                                    Width="24" Height="24" Padding="0"
                                    VerticalAlignment="Center" Margin="6,0,0,0"
                                    ToolTip="在当前目录新建文件夹">
                                <Image Source="/Images/ico/new%20file-ico.png"
                                       Width="16" Height="16" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 本地列表的处理范围条：只有勾选的文件会被处理。
                     放在内容区上方另起一条（与 115 网盘底部那条同款），本地模式才显示 -->
                <Border DockPanel.Dock="Bottom"
                        Background="#F6FBFF"
                        BorderBrush="#DCE9F7"
                        BorderThickness="0,1,0,0"
                        Padding="8,6"
                        Margin="0,8,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <!-- 只在「本地列表」这一屏显示：进 115 网盘或打开字幕编辑器时都收起来 -->
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding N115.IsLocalMode}" Value="True"/>
                                        <Condition Binding="{Binding CurrentMode}" Value="List"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"
                                   Text="{Binding ScopeSummary}"
                                   ToolTip="只有勾选的文件会被改名 / 改内容，取消勾选的行原样不动；序号也会按勾选范围重算。">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#4F6E95"/>
                                    <Style.Triggers>
                                        <!-- 一个都没勾选：会处理全部，用警示色提醒一下，避免看漏 -->
                                        <DataTrigger Binding="{Binding ScopeWarning}" Value="True">
                                            <Setter Property="Foreground" Value="#C0392B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0"
                                   Foreground="#8A94A6" TextTrimming="CharacterEllipsis"
                                   Text="勾选列表左侧「参与」列的文件才会被处理；勾选变化后「预览」列会立刻按勾选范围重排序号"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="全选" Command="{Binding CheckAllFilesCommand}" Width="60" Height="26" Margin="0,0,6,0"
                                    ToolTip="勾选全部文件，让它们都参与处理"/>
                            <Button Content="全不选" Command="{Binding UncheckAllFilesCommand}" Width="70" Height="26"
                                    ToolTip="取消全部勾选。都不勾选时按「处理全部」执行（范围条上会写明）"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid>
                <DataGrid x:Name="LocalFileGrid"
                          ItemsSource="{Binding Files}"
                          SelectedItem="{Binding SelectedFile}"
                          PreviewMouseLeftButtonDown="LocalFileGrid_PreviewMouseLeftButtonDown"
                          AllowDrop="True"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          CanUserResizeColumns="True"
                          Sorting="LocalFileGrid_Sorting"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          MouseDoubleClick="LocalFileGrid_MouseDoubleClick"
                          PreviewKeyDown="LocalFileGrid_PreviewKeyDown"
                          MouseMove="LocalFileGrid_MouseMove"
                          DragOver="LocalFileGrid_ReorderDragOver"
                          DragLeave="LocalFileGrid_ReorderDragLeave"
                          Drop="LocalFileGrid_ReorderDrop">
                    <!-- 列宽：拖表头分隔线即可调整，拖完自动存进 data\column-widths.json，下次启动照旧；
                         双击分隔线按内容自适应。-「重置列宽为默认」是列被拖窄到看不见时唯一顺手的救命入口。
                         星号列（2* / 3*）没被拖过就仍是星号，会跟着窗口一起伸缩，不会被这次改动锁死。 -->
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="重置列宽为默认" Click="ResetColumnWidths_Click"
                                      ToolTip="恢复默认列宽，并清掉已保存的列宽记录（下次启动也是默认布局）"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentMode}" Value="Editor">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <!-- 「原文件名」可点表头排序（点一次降序，再点升序）：
                             SortMemberPath 只是给 Sorting 事件里的代码识别是哪一列（= 属性名），
                             真正的排序在 VM 里做 —— 它会真的重排 Files 集合并重算预览里的序号，
                             所以 Sorting 事件会 Handled=true 拦掉 DataGrid 自带的排序。
                             「预览」是算出来的结果（含按勾选范围生成的序号），「状态」是图标，
                             排它们没有意义，故 CanUserSort=False。 -->
                        <!-- 「参与」复选框：只有勾选的文件才会被处理（默认全部勾选，所以旧用法不变）。
                             点击由 LocalFileGrid_PreviewMouseLeftButtonDown 拦下并手动翻转，
                             免得勾个选就把该行选中、进而把字幕文件切到编辑器。 -->
                        <DataGridTemplateColumn Header="参与" Width="52" IsReadOnly="False" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ToolTip="勾选 = 参与本次处理；取消勾选 = 原样不动"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="原文件名" Width="2*" IsReadOnly="True"
                                                CanUserSort="True" SortMemberPath="OriginalFileName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Style="{StaticResource RowIconStyle}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding OriginalFileName}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- 「预览」只在勾选的行上显示新名字；未勾选的行留空（悬停说明原因），
                             免得调一下规则那些行的预览也跟着变，看起来像它们也要被处理。 -->
                        <DataGridTextColumn Header="预览" Binding="{Binding Preview}" Width="3*" IsReadOnly="True"
                                            CanUserSort="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Background" Value="#EAF4FF"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="ToolTip" Value="{Binding PreviewTip}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewInScope}" Value="False">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </DataTrigger>
                                        <!-- 行选中时不再显示预览底色块：否则单元格选中底色会从
                                             底色块的 Padding 四周露出来，看着像一圈边框 -->
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Padding" Value="4,2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- 「状态」= 处理状态图标 + 编辑图标（仅文本 / 字幕文件显示，点击进编辑器；
                             双击行同样能进）。二进制文件没有编辑图标。 -->
                        <DataGridTemplateColumn Header="状态" Width="86" IsReadOnly="True" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="18" Height="18" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="#D9D9D9"/>
                                                    <Setter Property="Background" Value="#FAFAFA"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#1296DB"/>
                                                            <Setter Property="Background" Value="#E6F7FF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#52C41A"/>
                                                            <Setter Property="Background" Value="#F6FFED"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                                            <Setter Property="BorderBrush" Value="#FF696A"/>
                                                            <Setter Property="Background" Value="#FFF1F0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Viewbox Margin="2">
                                                <Path Style="{StaticResource StatusIconPathStyle}"/>
                                            </Viewbox>
                                        </Border>
                                        <!-- 编辑图标按钮：文本 / 字幕文件显示，点击进入编辑模式 -->
                                        <Button Click="EditIcon_Click" Width="24" Height="24" Margin="6,0,0,0"
                                                Focusable="False" Cursor="Hand"
                                                ToolTip="编辑内容（双击行也可以进入）">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTextFile}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#E6F3FF"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Image Source="/Images/ico/Edit-ico-1.png"
                                                   Width="16" Height="16"
                                                   Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 编辑器 = 行号列 + 内容框。
                     2026-10-05 用户要求**自动换行**（TextWrapping=Wrap）：长行折行显示，不再横向滚动。
                     ⚠️ 折行的「显示行」会多于「物理行」，行号列按物理行编号，长行之后会有轻微错位 ——
                     这是 TextBox 的固有限制（拿不到每个显示行的位置）。横向滚动条随 Wrap 关闭。 -->
                <Grid x:Name="EditorGrid" IsVisibleChanged="EditorGrid_IsVisibleChanged">
                    <!-- ⚠️ 默认 Collapsed 必须写在 Style 的 Setter 里，不能写成元素本地属性：
                         WPF 依赖属性优先级「本地值 > Style 触发器」，写成本地属性的话
                         下面的 DataTrigger 永远翻不转，编辑器区域会一直隐藏（内容空白）。 -->
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentMode}" Value="Editor">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SubtitleLineNumbersBox" Grid.Column="0"
                                 IsReadOnly="True" Focusable="False" IsTabStop="False"
                                 TextAlignment="Right" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"
                                 FontFamily="Consolas, Microsoft YaHei" FontSize="13"
                                 Background="#C9D6E8" Foreground="#1A1A1A"
                                 BorderThickness="0,1,0,0" BorderBrush="#D9D9D9"
                                 Padding="0,4,0,4"
                                 Text="1"/>
                        <TextBox x:Name="SubtitleEditorBox" Grid.Column="1"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 FontFamily="Consolas, Microsoft YaHei"
                                 FontSize="13"
                                 IsReadOnly="{Binding SelectedFile.IsReadOnly}"
                                 Background="#012443"
                                 Foreground="#FFFFFF"
                                 CaretBrush="#FFFFFF"
                                 SelectionBrush="#FFFF26" SelectionOpacity="1"
                                 SelectionTextBrush="#FF000000"
                                 Text="{Binding SelectedFile.Content, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="SubtitleEditor_TextChanged"
                                 Loaded="SubtitleEditor_Loaded"
                                 BorderThickness="0,1,0,0"
                                 BorderBrush="#D9D9D9"
                                 Padding="4">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFile.IsReadOnly}" Value="True">
                                            <Setter Property="ToolTip" Value="只读模式：文件或所在目录没有写入权限，可查看但无法保存"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>

                    <!-- 编辑器底部状态栏：总行数 / 总字数由代码随内容刷新；
                         文件大小 / 编码直接绑文件条目（保存、编码转换后属性通知会自动跟新） -->
                    <Border Grid.Row="1" Background="#F6FBFF" BorderBrush="#DCE9F7"
                            BorderThickness="0,1,0,0" Padding="10,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="行数 " Foreground="#4F6E95" FontSize="12"/>
                            <TextBlock x:Name="EditorStatLines" Text="0" Foreground="#1A1A1A" FontSize="12"
                                       FontFamily="Consolas, Microsoft YaHei" MinWidth="30"/>
                            <TextBlock Text="    字数 " Foreground="#4F6E95" FontSize="12"/>
                            <TextBlock x:Name="EditorStatChars" Text="0" Foreground="#1A1A1A" FontSize="12"
                                       FontFamily="Consolas, Microsoft YaHei" MinWidth="30"/>
                            <TextBlock Text="    大小 " Foreground="#4F6E95" FontSize="12"/>
                            <TextBlock x:Name="EditorStatSize" Text="{Binding SelectedFile.FileSizeLabel, TargetNullValue=-}"
                                       Foreground="#1A1A1A" FontSize="12" FontFamily="Consolas, Microsoft YaHei"/>
                            <TextBlock Text="    编码 " Foreground="#4F6E95" FontSize="12"/>
                            <TextBlock x:Name="EditorStatEnc" Text="{Binding SelectedFile.EncodingLabel, TargetNullValue=自动检测}"
                                       Foreground="#1A1A1A" FontSize="12" FontFamily="Consolas, Microsoft YaHei"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 115 网盘浏览：双击文件夹进入，单击/Ctrl/Shift 多选，
                     按右侧功能栏规则改名；文件与文件夹需分开选择（不能同批改名） -->
                <DockPanel Background="#FFFFFF"
                           Visibility="{Binding N115.IsActive, Converter={StaticResource BoolToVis}}">
                    <!-- 底部操作条，两行：上行是选择摘要 + 状态，下行是操作按钮。
                         之所以拆两行 —— 三者挤在一行时，按钮要跟状态文字抢宽度：窗口窄一点，
                         状态文字要么被压成一条缝、要么按钮（包括最右边的主按钮）被裁掉一角。
                         拆开后状态文字独占一行、能完整显示，按钮那行也永远排得整齐。
                         按钮用 WrapPanel：万一以后再加按钮 / 窗口极窄，是换行而不是被裁。 -->
                    <Border x:Name="N115RenameBar"
                            DockPanel.Dock="Bottom"
                            Background="#F6FBFF"
                            BorderBrush="#DCE9F7"
                            BorderThickness="0,1,0,0"
                            Padding="8,6"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 第 1 行：选择摘要（定宽、不省略）+ 状态文本（占满剩余、过长省略） -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontWeight="Bold"
                                           ToolTip="单击选中一个；Ctrl + 单击多选；Shift + 单击连选。&#10;文件和文件夹需分开选，不能在同一次操作里一起改名。"
                                           Foreground="#4F6E95" Text="{Binding N115.SelectionSummary}"/>
                                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding N115.StatusText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#8A94A6"/>
                                            <!-- 执行中（加载 / 改名 / 拖动移动等）红字加粗：
                                                 拖放移动没有确认框，松手后靠它确认「已经在执行」 -->
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding N115.IsBusy}" Value="True">
                                                    <Setter Property="Foreground" Value="#D62828"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>

                            <!-- 第 2 行：操作按钮。按「选择」与「改名」分两组，组间一条竖细线；
                                 主按钮（按规则重命名）放最右，整排里唯一实心。 -->
                            <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="加载更多" Command="{Binding N115.LoadMoreCommand}"
                                        Style="{StaticResource BarButtonStyle}"
                                        ToolTip="继续载入当前目录里还没显示出来的条目"/>

                                <Border Style="{StaticResource BarGroupStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="只选文件" Command="{Binding N115.SelectFilesCommand}"
                                                Style="{StaticResource BarButtonStyle}"
                                                ToolTip="一键选中当前目录里的全部文件（不含文件夹）"/>
                                        <Button Content="只选文件夹" Command="{Binding N115.SelectFoldersCommand}"
                                                Style="{StaticResource BarButtonStyle}"
                                                ToolTip="一键选中当前目录里的全部文件夹（不含文件）"/>
                                        <Button Content="清除选择" Command="{Binding N115.ClearSelectionCommand}"
                                                Style="{StaticResource BarButtonStyle}"
                                                ToolTip="取消所有选中。只影响选择，不会改动网盘上的任何东西"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource BarGroupStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="撤销改名" Command="{Binding N115.UndoRenameCommand}"
                                                Style="{StaticResource BarButtonStyle}"
                                                ToolTip="撤销上一次改名，把名字改回去。&#10;可连续回退，一直到本次运行内改过的每一条都还原"/>
                                        <Button Content="繁=&gt;简" Command="{Binding N115.ToSimplifiedCommand}"
                                                Style="{StaticResource BarAccentButtonStyle}"
                                                ToolTip="把选中条目名称里的繁体字转成简体（只改名字；网盘上的文件内容不会被读取或改写）。&#10;文件名与文件夹需分开选，不能同批处理。&#10;改错了点「撤销改名」可回退。"/>
                                        <Button Content="{Binding N115.RenameButtonText}" Command="{Binding N115.RenameSelectedCommand}"
                                                Style="{StaticResource BarPrimaryButtonStyle}"
                                                ToolTip="按右侧功能栏的替换 / 序号 / 添加删除规则重命名。文件和文件夹需分开处理。"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Grid>
                    <DataGrid x:Name="N115Grid"
                              ItemsSource="{Binding N115.Items}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="True"
                              CanUserResizeColumns="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              IsReadOnly="True"
                              Sorting="N115Grid_Sorting"
                              SelectionChanged="N115Grid_SelectionChanged"
                              PreviewMouseLeftButtonDown="N115Grid_PreviewMouseLeftButtonDown"
                              MouseDoubleClick="N115Grid_MouseDoubleClick"
                              AllowDrop="True"
                              MouseMove="N115Grid_MouseMove"
                              DragOver="N115Grid_DragOver"
                              DragLeave="N115Grid_DragLeave"
                              Drop="N115Grid_Drop">
                        <!-- 与本地列表同一套列宽记忆（落盘键不同：local / n115） -->
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="重置列宽为默认" Click="ResetColumnWidths_Click"
                                          ToolTip="恢复默认列宽，并清掉已保存的列宽记录（下次启动也是默认布局）"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>

                        <!-- 文件夹行铺一层浅蓝底色（像分组标题），文件行保持白底并缩进；
                             首行「返回上级」是导航行，用灰白底和它们区分开 -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                        <Setter Property="Background" Value="#EAF4FF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsParentEntry}" Value="True">
                                        <Setter Property="Background" Value="#F1F4F8"/>
                                    </DataTrigger>
                                    <!-- 选中态放在最后，保证选中色能盖过文件夹/导航行底色 -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#CBE3FB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <!-- 名称 / 类型 / 大小 / 修改时间 四列都可点表头排序（点一次降序，再点升序）。
                                 SortMemberPath 只是给排序事件里的代码用来识别是哪一列；
                                 真正的排序在 VM 里做（必须保证「文件夹置顶」和首行「返回上级」不被排乱），
                                 所以 Sorting 事件会 Handled=true 拦掉 DataGrid 自带的排序。
                                 「预览」列是算出来的结果，不参与排序（CanUserSort=False）。 -->
                            <DataGridTemplateColumn Header="名称" Width="3*" IsReadOnly="True"
                                                    CanUserSort="True" SortMemberPath="Name"
                                                    SortDirection="Ascending">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Style.Triggers>
                                                        <!-- 文件相对文件夹缩进，视觉上归到上方文件夹的分组里 -->
                                                        <DataTrigger Binding="{Binding IsDirectory}" Value="False">
                                                            <Setter Property="Margin" Value="26,0,0,0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 文件夹用闭合图标，被选中的文件夹换成打开图标；
                                                 「返回上级」行没有图标，改用「↑」字形 -->
                                            <Image Grid.Column="0">
                                                <Image.Style>
                                                    <Style TargetType="Image" BasedOn="{StaticResource RowIconStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsParentEntry}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsDirectory}" Value="True"/>
                                                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Source" Value="{StaticResource IconFolderOpen}"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>

                                            <TextBlock Grid.Column="0"
                                                       Text="↑"
                                                       Width="24"
                                                       Margin="0,0,6,0"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       Foreground="#5B7FA6"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsParentEntry, Converter={StaticResource BoolToVis}}"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 「预览」列：按右侧功能栏当前的替换 / 序号 / 添加删除规则算出的新名称。
                                 改规则时整列实时跟着变，改名前进能看到「会改成什么样」。
                                 显示分档：**选中的**才会真的改名（蓝字加粗=会变、灰字=算完不变、红字=参数不合法），
                                 **没选中的**整格淡化（浅灰）—— 它们不参与本次改名。
                                 长文件名会被裁切，鼠标悬停 ToolTip 显示「原名 → 新名」。 -->
                            <DataGridTextColumn Header="预览" Binding="{Binding Preview}" Width="3*" IsReadOnly="True"
                                                CanUserSort="False">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="Foreground" Value="#8A94A6"/>
                                        <Setter Property="ToolTip" Value="{Binding PreviewTip}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PreviewChanged}" Value="True">
                                                <Setter Property="Foreground" Value="#1666C8"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PreviewError}" Value="True">
                                                <Setter Property="Foreground" Value="#C0392B"/>
                                            </DataTrigger>
                                            <!-- 放在最后：未选中优先级最高，一律淡化，不再显示蓝/红 -->
                                            <DataTrigger Binding="{Binding InRenameScope}" Value="False">
                                                <Setter Property="Foreground" Value="#BFC7D2"/>
                                                <Setter Property="FontWeight" Value="Normal"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 三列都要显式 VerticalAlignment=Center：DataGridTextColumn 生成的
                                 TextBlock 默认会被拉伸到整行高，文字就贴在格子顶部了（用户反馈的现象） -->
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="80" IsReadOnly="True"
                                                CanUserSort="True" SortMemberPath="Type">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="Foreground" Value="#4A5560"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100" IsReadOnly="True"
                                                CanUserSort="True" SortMemberPath="Size">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#4A5560"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="修改时间" Binding="{Binding UpdateTimeText}" Width="140" IsReadOnly="True"
                                                CanUserSort="True" SortMemberPath="Time">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#4A5560"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                        <!-- 空目录提示：避免“进去一片空白”被当成功能故障 -->
                        <TextBlock Text="当前目录为空，没有文件或文件夹"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="#A6B0BC"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding N115.IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </DockPanel>
                </Grid>
            </DockPanel>
        </GroupBox>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <GroupBox Header="批量替换" Margin="0,0,0,10" Style="{StaticResource RoundedGroupBoxStyle}" Background="#EEF7FF">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="添加规则"
                                    Command="{Binding AddRuleCommand}"
                                    Width="88" Height="30"
                                    Margin="0,0,6,0"
                                    Background="#FFFFFF"
                                    BorderBrush="#87B6EA"/>
                            <Button Content="删除选中规则"
                                    Command="{Binding RemoveRuleCommand}"
                                    Width="108" Height="30"
                                    Margin="0,0,6,0"
                                    Background="#FFFFFF"
                                    BorderBrush="#87B6EA"/>
                            <Button Content="说明"
                                    Click="ShowReplaceHelp_Click"
                                    Width="68" Height="30"
                                    ToolTip="查看批量替换里能用的通配符与变量（### / * / ? / {英文} / {数字} / {中文}…），弹窗里可一键复制"
                                    Background="#F0F7FF"
                                    BorderBrush="#87B6EA"/>
                        </StackPanel>

                        <ListBox Grid.Row="1"
                                  ItemsSource="{Binding Rules}"
                                  SelectedItem="{Binding SelectedRule}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#F5F9FF"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#B7D7FF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#EAF3FF"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#4A90E2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1" BorderBrush="#DDD" Padding="6" HorizontalAlignment="Stretch" MaxWidth="900">
                                        <StackPanel>
                                            <TextBlock Text="查找（Find）"/>
                                            <TextBox Margin="0,3,0,6" Height="52"
                                                     TextWrapping="Wrap" AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"/>

                                            <TextBlock Text="替换为（Replace）"/>
                                            <TextBox Margin="0,3,0,0" Height="52"
                                                     TextWrapping="Wrap" AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 底部操作行：查找 / 替换（原「应用到编辑器」）。
                             放在规则列表下面贴着查找内容区 —— 编辑模式里填完规则直接找 / 替，不用抬头找按钮；
                             也修掉了原先挤在标题行里被裁掉的问题（横向 StackPanel 窄时不换行只会硬裁）。 -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Content="查找"
                                    Click="FindInEditor_Click"
                                    Width="76" Height="28" Margin="0,0,8,0"
                                    Background="#FFFFFF" BorderBrush="#87B6EA"
                                    ToolTip="在正在编辑的内容里查找选中规则（没选中就用第一条）的「查找内容」，找到后高亮选中并滚动过去；&#10;连续点会从当前位置往后找，到结尾再绕回开头。"/>
                            <Button Content="替换"
                                    Command="{Binding ApplyRulesToEditorCommand}"
                                    Width="76" Height="28"
                                    Background="#1890FF" Foreground="White" FontWeight="SemiBold"
                                    ToolTip="把上面这些替换规则应用到**正在编辑的文件**内容上，就地保存（沿用当前编码，写回前留 .bak）。&#10;只在编辑模式里可用；回列表模式用各组的「开始」处理整批文件。"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="批量序号" Margin="0,0,0,10" Style="{StaticResource RoundedGroupBoxStyle}" Background="#FFFFFF">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <!-- 模板输入框原本写死 340：功能区收窄后会把右边顶出边界，改成 * 自适应 -->
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="模板" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Height="24" MinWidth="80" Margin="0,0,8,8" VerticalContentAlignment="Center" Text="{Binding SequenceTemplate, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- 预设下拉原本写死 220，同样改成占满剩余宽度 -->
                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="保存为模板" Height="24" Padding="8,0" Margin="0,0,6,0" Command="{Binding SaveSequenceTemplateCommand}"/>
                            <TextBlock Grid.Column="1" Text="▶" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="2" Text="预设" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="3" Height="24" MinWidth="120" HorizontalAlignment="Stretch" ItemsSource="{Binding SequenceTemplatePresets}" SelectedItem="{Binding SelectedSequencePreset, Mode=TwoWay}"/>
                        </Grid>

                        <!-- 三个数字带微调按钮：窄到放不下时换行，而不是被硬裁 -->
                        <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                            <TextBlock Text="开始于" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Grid Width="66" Height="26" Margin="0,0,10,0">
                                <TextBox Height="26" Padding="6,0,20,0" TextAlignment="Left" VerticalContentAlignment="Center" Text="{Binding SequenceStart, UpdateSourceTrigger=PropertyChanged}"/>
                                <Grid HorizontalAlignment="Right" Width="18" Height="26">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="13"/>
                                        <RowDefinition Height="13"/>
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0" Content="▲" Style="{StaticResource SpinnerButtonStyle}" Click="AdjustNumber_Click" Tag="SeqStart:+1"/>
                                    <Button Grid.Row="1" Content="▼" Style="{StaticResource SpinnerButtonStyle}" BorderThickness="0" Click="AdjustNumber_Click" Tag="SeqStart:-1"/>
                                </Grid>
                            </Grid>
                            <TextBlock Text="增量" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Grid Width="66" Height="26" Margin="0,0,10,0">
                                <TextBox Height="26" Padding="6,0,20,0" TextAlignment="Left" VerticalContentAlignment="Center" Text="{Binding SequenceStep, UpdateSourceTrigger=PropertyChanged}"/>
                                <Grid HorizontalAlignment="Right" Width="18" Height="26">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="13"/>
                                        <RowDefinition Height="13"/>
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0" Content="▲" Style="{StaticResource SpinnerButtonStyle}" Click="AdjustNumber_Click" Tag="SeqStep:+1"/>
                                    <Button Grid.Row="1" Content="▼" Style="{StaticResource SpinnerButtonStyle}" BorderThickness="0" Click="AdjustNumber_Click" Tag="SeqStep:-1"/>
                                </Grid>
                            </Grid>
                            <TextBlock Text="位数" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Grid Width="66" Height="26" Margin="0,0,0,0">
                                <TextBox Height="26" Padding="6,0,20,0" TextAlignment="Left" VerticalContentAlignment="Center" Text="{Binding SequenceDigits, UpdateSourceTrigger=PropertyChanged}"/>
                                <Grid HorizontalAlignment="Right" Width="18" Height="26">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="13"/>
                                        <RowDefinition Height="13"/>
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0" Content="▲" Style="{StaticResource SpinnerButtonStyle}" Click="AdjustNumber_Click" Tag="SeqDigits:+1"/>
                                    <Button Grid.Row="1" Content="▼" Style="{StaticResource SpinnerButtonStyle}" BorderThickness="0" Click="AdjustNumber_Click" Tag="SeqDigits:-1"/>
                                </Grid>
                            </Grid>
                        </WrapPanel>

                        <!-- 原来这两条 StackPanel 都放在 Row=3 的同一个单元格里（一条靠左一条靠右）。
                             功能区收窄后会被压到互相重叠，所以把按钮挪到独立的 Row=4。 -->
                        <WrapPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center">
                            <CheckBox Content="不足位补齐" VerticalAlignment="Center" IsChecked="{Binding SequencePadEnabled}" Margin="0,0,10,0"/>
                            <CheckBox Content="字母编码" VerticalAlignment="Center" IsChecked="{Binding SequenceAlphabetic}" Margin="0,0,10,0"/>
                            <CheckBox Content="字母大写" VerticalAlignment="Center" IsChecked="{Binding SequenceUppercase}"/>
                        </WrapPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="变量说明" Width="68" Height="24" Margin="0,0,8,0" Click="SequenceVariables_Click"
                                    ToolTip="查看模板里能用的变量（原名称 / 序号 / 修改日期 / 文件类型…），弹窗里可一键复制"/>
                            <!-- 开始/撤销双路由：网盘模式（N115.IsActive）作用于网盘选中项，本地模式作用于本地列表 -->
                            <Button Content="撤销" Width="68" Height="24" Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Command" Value="{Binding UndoSequenceCommand}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding N115.IsActive}" Value="True">
                                                <Setter Property="Command" Value="{Binding N115.UndoRenameCommand}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="开始" Width="68" Height="24" Background="#1890FF" Foreground="White">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Command" Value="{Binding RunReplaceOnlyCommand}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding N115.IsActive}" Value="True">
                                                <Setter Property="Command" Value="{Binding N115.RenameSelectedCommand}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Margin="0,0,0,10" Style="{StaticResource RoundedGroupBoxStyle}" Background="#EEF7FF">
                    <GroupBox.Header>
                        <!-- 可折叠分组头：整条标题栏可点（Background=Transparent 保证空白处也命中），Tag=记忆键 -->
                        <Border Background="Transparent" Cursor="Hand" Tag="add-del-filename"
                                MouseLeftButtonUp="SectionHeader_Click"
                                ToolTip="点击展开 / 收起（状态会记住，下次启动照旧）">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Tag="chevron" Text="▸" FontSize="10" Foreground="#4F6E95"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="添加/删除（文件名）" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </GroupBox.Header>
                    <StackPanel Margin="8">
                        <GroupBox Header="添加" Margin="0,0,0,10">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <!-- 两个输入框原本各写死 100，改成 * + MinWidth：收窄时一起变窄，不会被顶出边界 -->
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" MinWidth="70"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" MinWidth="70"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="文件名前添加" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Height="24" Margin="0,0,0,8" TextAlignment="Left" VerticalContentAlignment="Center" Text="{Binding FileNamePrefixAdd, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="文件名后添加" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="0" Grid.Column="4" Height="24" Margin="0,0,0,8" TextAlignment="Left" VerticalContentAlignment="Center" Text="{Binding FileNameSuffixAdd, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="定位文字" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Height="24" Margin="0,0,0,8" TextAlignment="Left" VerticalContentAlignment="Center" Text="{Binding FileNameAddAnchor, UpdateSourceTrigger=PropertyChanged}"/>

                                <Grid Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="60"/>
                                    </Grid.ColumnDefinitions>

                                    <RadioButton Grid.Column="0" GroupName="AddPos" Content="前" IsChecked="{Binding FileNameAddBeforeAnchor}"
                                                 Height="24" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                    <RadioButton Grid.Column="1" GroupName="AddPos" Content="后" IsChecked="{Binding FileNameAddAfterAnchor}"
                                                 Height="24" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2" Text="添加" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="3" Height="24" TextAlignment="Left" VerticalContentAlignment="Center" Text="{Binding FileNameAddContent, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <StackPanel Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                    <Button Content="撤销" Width="68" Height="24" Margin="0,0,8,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Command" Value="{Binding UndoAddCommand}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding N115.IsActive}" Value="True">
                                                        <Setter Property="Command" Value="{Binding N115.UndoRenameCommand}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="开始" Width="68" Height="24" Background="#1890FF" Foreground="White">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Command" Value="{Binding RunReplaceOnlyCommand}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding N115.IsActive}" Value="True">
                                                        <Setter Property="Command" Value="{Binding N115.RenameSelectedCommand}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="删除">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="删除文件名中的" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Height="24" MinWidth="90" Margin="0,0,0,8" HorizontalAlignment="Stretch" TextAlignment="Left" VerticalContentAlignment="Center" Text="{Binding FileNameDeleteAnchor, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- 这一行原本是 492px 宽的单行 StackPanel，功能区收窄后一定被裁。
                                     改成 WrapPanel：宽的时候一行摆完，窄的时候在「共删除」后换行（语义不打断）。 -->
                                <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                        <TextBlock Text="从" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Width="70" Height="24" Margin="0,0,12,0" TextAlignment="Left" VerticalContentAlignment="Center" Text="{Binding FileNameDeleteAnchor, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="或" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Grid Width="58" Height="26" Margin="0,0,8,0">
                                            <TextBox Height="26" Padding="6,0,20,0" TextAlignment="Left" VerticalContentAlignment="Center" Text="{Binding FileNameDeleteStartIndex, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Grid HorizontalAlignment="Right" Width="18" Height="26">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="13"/>
                                                    <RowDefinition Height="13"/>
                                                </Grid.RowDefinitions>
                                                <Button Grid.Row="0" Content="▲" Style="{StaticResource SpinnerButtonStyle}" Click="AdjustNumber_Click" Tag="Start:+1"/>
                                                <Button Grid.Row="1" Content="▼" Style="{StaticResource SpinnerButtonStyle}" BorderThickness="0" Click="AdjustNumber_Click" Tag="Start:-1"/>
                                            </Grid>
                                        </Grid>
                                        <TextBlock Text="个字符开始，共删除" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Grid Width="58" Height="26" Margin="0,0,8,0">
                                            <TextBox Height="26" Padding="6,0,20,0" TextAlignment="Left" VerticalContentAlignment="Center" Text="{Binding FileNameDeleteCount, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Grid HorizontalAlignment="Right" Width="18" Height="26">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="13"/>
                                                    <RowDefinition Height="13"/>
                                                </Grid.RowDefinitions>
                                                <Button Grid.Row="0" Content="▲" Style="{StaticResource SpinnerButtonStyle}" Click="AdjustNumber_Click" Tag="Count:+1"/>
                                                <Button Grid.Row="1" Content="▼" Style="{StaticResource SpinnerButtonStyle}" BorderThickness="0" Click="AdjustNumber_Click" Tag="Count:-1"/>
                                            </Grid>
                                        </Grid>
                                        <CheckBox Content="前" IsChecked="{Binding FileNameDeleteByAnchorEnabled}" Margin="0,0,8,0"/>
                                        <CheckBox Content="后" IsChecked="{Binding FileNameDeleteAfterAnchor}"/>
                                    </StackPanel>
                                </WrapPanel>

                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                    <Button Content="撤销" Width="68" Height="24" Margin="0,0,8,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Command" Value="{Binding UndoDeleteCommand}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding N115.IsActive}" Value="True">
                                                        <Setter Property="Command" Value="{Binding N115.UndoRenameCommand}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="开始" Width="68" Height="24" Background="#1890FF" Foreground="White">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Command" Value="{Binding RunReplaceOnlyCommand}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding N115.IsActive}" Value="True">
                                                        <Setter Property="Command" Value="{Binding N115.RenameSelectedCommand}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </GroupBox>

                <GroupBox Margin="0,0,0,10" Style="{StaticResource RoundedGroupBoxStyle}" Background="#FFFFFF">
                    <GroupBox.Header>
                        <Border Background="Transparent" Cursor="Hand" Tag="delete-lines"
                                MouseLeftButtonUp="SectionHeader_Click"
                                ToolTip="点击展开 / 收起（状态会记住，下次启动照旧）">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Tag="chevron" Text="▸" FontSize="10" Foreground="#4F6E95"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="批量删除行" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </GroupBox.Header>
                    <StackPanel Margin="8">
                        <CheckBox Content="启用：删除指定行范围（含起止行）" IsChecked="{Binding DeleteLinesEnabled}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="起始行" VerticalAlignment="Center"/>
                            <TextBox Width="80" Margin="8,0,20,0" Text="{Binding DeleteStartLine}"/>
                            <TextBlock Text="结束行" VerticalAlignment="Center"/>
                            <TextBox Width="80" Margin="8,0,0,0" Text="{Binding DeleteEndLine}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Margin="0,0,0,10" Style="{StaticResource RoundedGroupBoxStyle}" Background="#EEF7FF">
                    <GroupBox.Header>
                        <Border Background="Transparent" Cursor="Hand" Tag="lang-subtitle"
                                MouseLeftButtonUp="SectionHeader_Click"
                                ToolTip="点击展开 / 收起（状态会记住，下次启动照旧）">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Tag="chevron" Text="▸" FontSize="10" Foreground="#4F6E95"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="删除字幕外语" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </GroupBox.Header>
                    <StackPanel Margin="8">
                        <CheckBox Content="删除英文（EN）" IsChecked="{Binding RemoveEnglish}"/>
                        <CheckBox Content="删除日文（JP，按平/片假名识别）" IsChecked="{Binding RemoveJapanese}" Margin="0,4,0,0"/>
                        <CheckBox Content="删除韩文（KR）" IsChecked="{Binding RemoveKorean}" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="开始处理" Width="80" Height="24" Background="#1890FF" Foreground="White"
                                    Command="{Binding RunLanguageOnlyCommand}"
                                    ToolTip="只做一件事：按上面勾选的语言过滤字幕正文并写回文件。&#10;只作用于文本类文件（字幕 / 文本），不改名、不套用替换规则。"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 「处理方式 / 选择目录」条已按用户要求移除（2026-10-05）：
                     处理永远就地覆盖写回（.bak 备份默认保留），输出到目录的模式下线。 -->

                <WrapPanel Margin="0,0,0,10">
                    <Button Content="开始处理" Width="80" Height="28" Background="#1890FF" Foreground="White" Command="{Binding RunCommand}" Margin="0,0,6,6"/>
                    <Button Content="批量处理" Width="80" Height="28" Background="#52C41A" Foreground="Black" Command="{Binding RunReplaceOnlyCommand}" Margin="0,0,6,6"/>
                    <Button Content="日志" Width="60" Height="28" Background="#FA8C16" Foreground="Black" Click="ShowLogs_Click" Margin="0,0,6,6"/>
                    <Button Content="检查更新" Width="80" Height="28" Click="CheckUpdate_Click" Margin="0,0,0,6"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
        </Grid>
    </Grid>
</Window>
