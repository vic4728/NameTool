<Window x:Class="NameTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:NameTool.ViewModels"
        xmlns:infra="clr-namespace:NameTool.Infrastructure"
        mc:Ignorable="d"
        Height="840" Width="1280" MinWidth="1040" MinHeight="620"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#F4F8FC"
        BorderBrush="#DCE6F2"
        BorderThickness="1"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewDragEnter="Window_PreviewDragEnter"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave"
        PreviewDrop="Window_PreviewDrop">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 图标资源键 -> App.xaml 里合并进来的矢量图标 -->
        <infra:IconLookupConverter x:Key="IconLookup"/>

        <!-- 行内小图标的统一样式：24×24、矢量缩放、垂直居中 -->
        <Style x:Key="RowIconStyle" TargetType="Image">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Source" Value="{Binding IconKey, Converter={StaticResource IconLookup}}"/>
        </Style>

        <!-- 编辑图标已改为 Images/ico/Edit-ico-1.png（256px 高清位图，见文件列表行内按钮）。 -->

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C9DDF4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F2F8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E8F2FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列表底部「操作条」上的按钮（115 网盘那一排）。
             为什么要单独一组：隐式样式是白底 + 极浅蓝边框（#C9DDF4），压在同样浅蓝的底条
             （#F6FBFF）上时边界几乎看不见 —— 用户反馈「看起来不像按键」。
             这里把边框加深、并把高度/内边距/最小宽度统一固定：一排长短不一的文案要靠同一组尺寸
             约束对齐，而不是各自写 Width（那样只会更乱）。
             hover / pressed 用一层半透明遮罩（不是写死某个颜色），所以同一份模板能直接套在
             白底、橙底、蓝底三种按钮上，不必像 OrangeButtonStyle 那样各抄一份模板。
             另外顺手修掉一个老问题：隐式样式的模板里 ContentPresenter 没绑 Padding，
             所以以前写在按钮上的 Padding 其实是无效的（宽度全靠文案撑）。这里绑上了。 -->
        <Style x:Key="BarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#33475B"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#AECBEC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BarBorder" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Border x:Name="BarOverlay" CornerRadius="5" Background="Transparent"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BarOverlay" Property="Background" Value="#14000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BarOverlay" Property="Background" Value="#26000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BarBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 「繁=>简」：与本地列表工具条上那一颗同色系（橙），一眼看出是同一件事 -->
        <Style x:Key="BarAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource BarButtonStyle}">
            <Setter Property="Background" Value="#FFF3E8"/>
            <Setter Property="BorderBrush" Value="#E0AE6E"/>
            <Setter Property="Foreground" Value="#8A5A12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- 主动作（按规则重命名）：整排里唯一实心，视线自然落上去 -->
        <Style x:Key="BarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BarButtonStyle}">
            <Setter Property="Background" Value="#1890FF"/>
            <Setter Property="BorderBrush" Value="#0F7AE5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- 分组之间的竖细线。做成「左侧边框」而不是独立元素：跟着所在组一起换行，
             不会出现竖线孤零零留在行首 / 行尾的情况。
             不要给上下 margin —— 那会把整行撑高（WrapPanel 的行高按最高的子元素算），
             结算下来按钮行会变成 32 而不是 26，白白多占 6px 高。 -->
        <Style x:Key="BarGroupStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#D3E2F4"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="Padding" Value="7,0,0,0"/>
        </Style>

        <!-- 橙色强调按钮（「返回本地列表」用）。
             注意：必须自己带一份模板，隐式 Button 样式的 hover 触发器会把背景刷成浅蓝，
             那种情况下的橙色只在没悬停时成立，鼠标一放上去就「变色」了。 -->
        <Style x:Key="OrangeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F5821F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#D96F10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OrangeBorder"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OrangeBorder" Property="Background" Value="#FF9B3D"/>
                                <Setter TargetName="OrangeBorder" Property="BorderBrush" Value="#E88425"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="OrangeBorder" Property="Background" Value="#D96F10"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OrangeBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 路径栏里的目录名：纯文字链接，不要边框、不要底色、不带图标。
             必须自带模板 —— 隐式 Button 样式会画出浅蓝边框，悬停时还会填底色。 -->
        <Style x:Key="CrumbLinkStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#1A6FD4"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#F5821F"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#9AA6B2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleButtonBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleButtonBorder" Property="Background" Value="#E4E4E4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TitleButtonBorder" Property="Background" Value="#DADADA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#CFE0F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#EAF4FF" CornerRadius="8,8,0,0" BorderBrush="#DCE9F7" BorderThickness="0,0,0,1">
                                    <ContentPresenter ContentSource="Header" Margin="10,0" VerticalAlignment="Center"/>
                                </Border>

                                <!-- ⚠️ BodyPresenter 这个名字被「分组展开/收起」功能按 Template.FindName 查找，
                                     收起 = 把它整个 Collapsed（连带 Margin=8 一起消失，不留白缝）。别改名。 -->
                                <ContentPresenter x:Name="BodyPresenter" Grid.Row="1" Margin="8"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpinnerButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#EAF3FF"/>
            <Setter Property="Foreground" Value="#4F6E95"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SpinnerButtonBorder" Background="{TemplateBinding Background}" BorderBrush="#C9DDF4" BorderThickness="0,0,0,1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SpinnerButtonBorder" Property="Background" Value="#DCEBFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SpinnerButtonBorder" Property="Background" Value="#CFE2FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

