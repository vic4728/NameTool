<Window x:Class="NameTool.MessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F4F8FC"
        MaxHeight="480">
    <!-- 统一消息对话框：替代系统 MessageBox 的灰色方角弹窗。
         风格与主窗口对齐 —— 浅蓝底 #F4F8FC、蓝 #1890FF 主按钮、白底浅蓝边框次按钮。
         按钮行由代码后置按 MessageBoxButton 生成，模板复用下面两组样式（hover 半透明遮罩，同主窗口底部按钮行）。 -->
    <Window.Resources>
        <!-- 对话框按钮公共模板：圆角 4 + 半透明遮罩 hover/pressed，白底蓝底通用 -->
        <ControlTemplate x:Key="DialogButtonTemplate" TargetType="Button">
            <Border x:Name="DialogButtonBorder" CornerRadius="4"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Border x:Name="DialogButtonOverlay" CornerRadius="4" Background="Transparent"/>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="DialogButtonOverlay" Property="Background" Value="#14000000"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="DialogButtonOverlay" Property="Background" Value="#26000000"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="DialogButtonBorder" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 主按钮（确定 / 是）：蓝底白字，主窗口「主动作」同款视觉层级 -->
        <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1890FF"/>
            <Setter Property="BorderBrush" Value="#0F7AE5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template" Value="{StaticResource DialogButtonTemplate}"/>
        </Style>

        <!-- 次按钮（否 / 取消）：白底浅蓝边框，主窗口隐式按钮同款 -->
        <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9DDF4"/>
            <Setter Property="Foreground" Value="#33475B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template" Value="{StaticResource DialogButtonTemplate}"/>
        </Style>
    </Window.Resources>

    <Border Background="#F4F8FC" Padding="18,16,18,14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="IconColumn" Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 图标：圆底 + Segoe MDL2 字形，颜色按 MessageBoxImage 分档 -->
                <Border x:Name="IconCircle" Grid.Column="0"
                        Width="36" Height="36" CornerRadius="18"
                        VerticalAlignment="Top" Margin="0,2,12,0">
                    <TextBlock x:Name="IconGlyph"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 消息正文：可选中复制（错误详情常要贴出来），白底无边框不抢眼 -->
                <TextBox x:Name="MessageText" Grid.Column="1"
                         IsReadOnly="True" IsTabStop="False"
                         Background="Transparent" BorderThickness="0"
                         Foreground="#33475B" FontSize="13"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"
                         Padding="0"
                         Cursor="Arrow"/>
            </Grid>

            <!-- 按钮行：代码后置生成，右对齐 -->
            <StackPanel x:Name="ButtonPanel" Grid.Row="2"
                        Orientation="Horizontal" HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</Window>
