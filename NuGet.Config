<?xml version="1.0" encoding="utf-8"?>
<!--
  本机直连 api.nuget.org 的 repository-signatures 会 SSL 失败（NU1301），
  导致任何新增 PackageReference 都无法还原。这里改用国内镜像源，只对本项目生效。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="tencent-mirror" value="https://mirrors.cloud.tencent.com/nuget/" protocolVersion="3" />
    <add key="aliyun-mirror" value="https://mirrors.aliyun.com/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
